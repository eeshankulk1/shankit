{
  "name": "@throukit/client",
  "version": "0.1.0",
  "description": "Typed TypeScript consumer for throukit agent event streams over SSE/HTTP. Consumes agent runs; does not run agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/throuai/throukit.git",
    "directory": "packages/client-ts"
  },
  "homepage": "https://github.com/throuai/throukit/tree/main/packages/client-ts",
  "bugs": {
    "url": "https://github.com/throuai/throukit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "sse",
    "streaming"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
